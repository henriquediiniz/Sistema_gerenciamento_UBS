# Node.js 24+. Banco local persistente; caminho relativo à raiz do projeto.
DATABASE_PATH=data/ubs.sqlite
# Execute npm run db:seed para criar a base de demonstração.
# Ative somente se estiver servindo a aplicação por HTTPS.
COOKIE_SECURE=false
# Atrás de proxy, defina a origem pública exata (sem barra final).
# APP_ORIGIN=https://ubs.exemplo.com

# Vercel: use um banco Turso/libSQL remoto. Nunca use NEXT_PUBLIC_ nestas variáveis.
# TURSO_DATABASE_URL=libsql://seu-banco.turso.io
# TURSO_AUTH_TOKEN=seu-token
# Consulte docs/deploy-vercel.md para inicializar e publicar.
